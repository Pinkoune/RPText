rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Vrai si l'appelant est un admin confirmé (flag isAdmin sur SON doc joueur,
    // qui ne peut être posé que par un admin existant ou la console Firebase).
    function isAdminUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.isAdmin == true;
    }

    // Multi-personnages : un compte possède jusqu'à 3 personnages. Le slot 0
    // garde la clé NUE du compte (compatibilité avec les sauvegardes d'avant le
    // multi-personnages, donc aucune migration), les suivants sont suffixés.
    // Les slots sont énumérés explicitement plutôt que découpés à la volée :
    // c'est plus sûr qu'un split() si un uid contenait un jour « __ ».
    //
    // Toutes les vérifications d'identité du jeu passent par cette fonction et
    // non par une comparaison directe à request.auth.uid : les services envoient
    // l'identifiant du PERSONNAGE actif (p.uid), qui n'est égal au compte que
    // pour le slot 0.
    function ownsCharacter(charId) {
      return request.auth != null && (
        charId == request.auth.uid
        || charId == request.auth.uid + '__1'
        || charId == request.auth.uid + '__2'
      );
    }

    // Empêche un joueur de s'auto-octroyer / modifier le flag isAdmin.
    // Autorisé seulement si : le champ est absent, explicitement false, ou
    // inchangé par rapport au doc existant.
    function adminFlagUntouched() {
      return !('isAdmin' in request.resource.data)
        || request.resource.data.isAdmin == false
        || (resource != null && request.resource.data.isAdmin == resource.data.isAdmin);
    }

    match /system/{document=**} {
      allow read: if true;
      // Seul un admin peut déclencher/écrire la config système (ex: wipe global).
      allow write: if isAdminUser();
    }
    match /endlessScores/{scoreId} {
      allow read: if true;
      // Chacun n'écrit que le score de ses propres personnages ; l'admin peut
      // purger (wipe total).
      allow write: if ownsCharacter(scoreId) || isAdminUser();
    }
    match /endlessScoresMulti/{scoreId} {
      allow read: if true;
      allow write: if ownsCharacter(scoreId) || isAdminUser();
    }

    // Chaque joueur écrit ses propres documents de personnage — mais NE PEUT PAS
    // se déclarer admin (privilege escalation). Un admin peut écrire n'importe
    // quel doc. Note : isAdminUser() lit players/{auth.uid}, c'est-à-dire le
    // slot 0 — le statut d'admin est donc bien attaché au compte, pas au perso.
    match /players/{charId} {
      allow read: if request.auth != null;            // profils lisibles (classement, PvP)
      allow write: if isAdminUser()
        || (ownsCharacter(charId) && adminFlagUntouched());
    }
    // Classement public en lecture, écriture via le doc joueur seulement.
    // Une ligne de classement par PERSONNAGE (et non par compte) : sinon posséder
    // plusieurs personnages ferait perdre son rang à chaque changement.
    match /leaderboard/{charId} {
      allow read: if request.auth != null;
      allow write: if ownsCharacter(charId) || isAdminUser();
    }
    // ⚠️ `duels` SUPPRIMÉ : l'ancien duel pile/face Firestore a été remplacé par
    // `pvpDuelService` (RTDB). Plus aucune référence dans le code — la règle ne
    // faisait qu'entretenir une collection ouverte en écriture pour rien.
    // Marché : annonces créées par le vendeur, achetables/annulables par tout joueur connecté.
    match /market/{listingId} {
      allow read: if request.auth != null;
      allow create: if ownsCharacter(request.resource.data.sellerUid);
      allow update: if request.auth != null;
    }
    // Card-Jitsu duels
    match /cj_duels/{duelId} {
      allow read: if request.auth != null;
      allow create: if ownsCharacter(request.resource.data.hostUid);
      allow update: if request.auth != null;
    }
    // Équipes : créées par l'hôte, rejoignables/quittables par les joueurs.
    // Suppression réservée à l'hôte (ou admin) pour éviter le griefing.
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if ownsCharacter(request.resource.data.hostUid);
      allow update: if request.auth != null;
      allow delete: if ownsCharacter(resource.data.hostUid) || isAdminUser();
    }
    // Guildes : fondées par l'owner, rejoignables/contributions par les joueurs.
    // Suppression réservée à l'owner (ou admin).
    match /guilds/{guildId} {
      allow read: if request.auth != null;
      allow create: if ownsCharacter(request.resource.data.ownerUid);
      allow update: if request.auth != null;
      allow delete: if ownsCharacter(resource.data.ownerUid) || isAdminUser();
    }
    // ⚠️ `gifts` SUPPRIMÉ : aucune référence dans le code (feature jamais
    // branchée). La règle laissait `update, delete` ouverts à tout compte
    // connecté sur une collection que personne n'écrit — surface d'attaque
    // gratuite. À rétablir AVEC une vraie condition si les dons reviennent.
  }
}
